# ==========================================
# Supabase Configuration
# ==========================================
# Thông tin lấy từ Supabase Dashboard:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/rest/v1/rpc/...

# Tương thích với các định dạng cũ (tùy chọn):
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# SUPABASE_ANON_KEY=your-supabase-anon-key

# ==========================================
# Auth & Security
# ==========================================
JWT_SECRET=your-super-secret-jwt-key-replace-me

# ==========================================
# Admin Seed Configuration (Tùy chọn)
# ==========================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=System Administrator

# ==========================================
# App Port & CORS
# ==========================================
PORT=3000
# Danh sách origins cho phép kết nối từ Front-end (phân tách bởi dấu phẩy, mặc định true cho mọi origin nếu để trống)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
